{
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "AccountService",
        "RateLimiterPolicy": "rateLimiterPolicy",
        "Match": {
          "Path": "/account/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "route2": {
        "ClusterId": "UnitService",
        "RateLimiterPolicy": "rateLimiterPolicy",
        "OutputCachePolicy": "unitCachePolicy",
        "Match": {
          "Path": "/unit/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "route3": {
        "ClusterId": "HandlerService",
        "Match": {
          "Path": "/handler/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "route4": {
        "ClusterId": "HandlerService",
        "Match": {
          "Path": "/SmartWaste/Api/Sigfox/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/sigfox/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "AccountService": {
        "Destinations": {
          "destination": {
            "Address": ""
          }
        }
      },
      "UnitService": {
        "Destinations": {
          "destination": {
            "Address": ""
          }
        }
      },
      "HandlerService": {
        "Destinations": {
          "destination": {
            "Address": ""
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
